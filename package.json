{
  "name": "dsh-huawei-connect",
  "displayName": "DSH Huawei Connect",
  "description": "把华为「果办 OfficeAce」与「码道 CodeArts」两个平台的模型接入 DeepSeek Harness：一处登录、积分余量与模型勾选、官方客户端同形态的请求伪装，避免被上游按渠道指纹拒绝。",
  "version": "1.2.0",
  "author": "wang111928",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "huawei",
    "codearts",
    "officeace",
    "model-provider",
    "credits"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-huawei-connect": "lib/bin.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "@earendil-works/pi-ai": ">=0.84.2 <2.0.0",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wang111928/dsh-huawei-connect.git"
  },
  "homepage": "https://github.com/wang111928/dsh-huawei-connect#readme",
  "bugs": {
    "url": "https://github.com/wang111928/dsh-huawei-connect/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
